# The Coterie Cup: the app (pages, bracket API). setup.sh installs it as
# /etc/systemd/system/cup-app.service
[Unit]
Description=The Coterie Cup app (Next.js)
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
User=cup
WorkingDirectory=/srv/cup
EnvironmentFile=/etc/cup.env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -p 3000 -H 127.0.0.1
Restart=always
RestartSec=2

[Install]
WantedBy=multi-user.target
