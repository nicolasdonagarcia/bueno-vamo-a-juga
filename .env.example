# Copy to .env.local for your own computer. On the droplet, deploy/setup.sh writes
# /etc/cup.env with these filled in; both services read it.

# --- Where the cups are kept: the first one that is set wins ---
# Redis on the same machine (the droplet: redis://127.0.0.1:6379)
REDIS_URL=
# or Upstash over HTTP (what the Vercel version used)
KV_REST_API_URL=
KV_REST_API_TOKEN=
# Neither: kept in memory, which is fine on your own computer and lost when it stops.

# --- The match server ---
# The same value for the app and the match server, at least 16 characters (openssl rand -hex 32).
# npm run dev and npm start make one up when it is empty.
MATCH_SECRET=
# Where browsers reach the match server:
#   /ws                  this site's own address (behind Caddy on the droplet)
#   :3001/ws             this site's host name on port 3001 (npm run dev, players on your Wi-Fi)
#   wss://cup.example.com/ws
# npm run dev and npm start use :3001/ws when it is empty. With no match server at all
# (MATCH_SERVER_URL or MATCH_SECRET missing), online matches run peer to peer.
MATCH_SERVER_URL=
# The match server's port and address (3001, 0.0.0.0; the droplet listens on 127.0.0.1)
MATCH_PORT=
MATCH_HOST=
# Where the match server sends kick-offs, goals and results (http://127.0.0.1:3000)
APP_URL=

# --- Optional: Cloudflare TURN relay, only for peer-to-peer matches ---
# (Cloudflare dashboard > Realtime > TURN Server > Create). Never put these in code.
CLOUDFLARE_TURN_KEY_ID=
CLOUDFLARE_TURN_API_TOKEN=
